@baseUrl = http://localhost:3000/api
@token = 

### ==============================
### AUTENTICACIÓN
### ==============================

### Registro de usuario
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Jose",
  "surname": "Martínez",
  "email": "josemartinezgarcia@gmail.com",
  "password": "JoseMartinez50@"
}

### Iniciar sesión
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "josemartinezgarcia@gmail.com",
  "password": "JoseMartinez50@"
}


### ==============================
### USUARIO
### ==============================

### Obtener perfil del usuario actual
GET {{baseUrl}}/users/profile
Authorization: Bearer {{token}}

### Actualizar perfil
PUT {{baseUrl}}/users/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Juan",
  "surname": "Garcia",
  "email": "juangarcia@gmail.com",
  "avatar_url": ""
}

### Eliminar mi usuario
DELETE {{baseUrl}}/users
Authorization: Bearer {{token}}


### ==============================
### TARJETAS
### ==============================

### Crear tarjeta
POST {{baseUrl}}/cards
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "logo_url": "",
  "title": "",
  "description": "",
  "documentation_url": "",
  "is_public": true,
  "tags": ["", ""]
}

### Obtener mis tarjetas
GET {{baseUrl}}/cards
Authorization: Bearer {{token}}

### Obtener mis tarjetas con búsqueda
GET {{baseUrl}}/cards/public
Authorization: Bearer {{token}}

### Obtener tarjeta por id
GET {{baseUrl}}/cards/1
Authorization: Bearer {{token}}

### Actualizar tarjeta
PUT {{baseUrl}}/cards/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "logo_url": "",
  "title": "",
  "description": "",
  "documentation_url": "",
  "is_public": true
}

### Eliminar tarjeta
DELETE {{baseUrl}}/cards/1
Authorization: Bearer {{token}}


### ==============================
### ETIQUETAS
### ==============================

### Añadir etiquetas a tarjeta
POST {{baseUrl}}/cards/1/tags
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "tags": ["", ""]
}

### Obtener etiquetas de tarjeta
GET {{baseUrl}}/cards/1/tags
Authorization: Bearer {{token}}

### Eliminar etiqueta de tarjeta
DELETE {{baseUrl}}/cards/1/tags/react
Authorization: Bearer {{token}}


### ==============================
### CONFIGURACIÓN
### ==============================

### Obtener configuración
GET {{baseUrl}}/settings
Authorization: Bearer {{token}}

### Actualizar configuración
PUT {{baseUrl}}/settings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "theme": "dark",
  "language": "es"
}


### ==============================
### ADMIN - USUARIOS
### ==============================

### Obtener todos los usuarios (admin)
GET {{baseUrl}}/admin/users
Authorization: Bearer {{token}}

### Obtener usuario por id (admin)
GET {{baseUrl}}/admin/users/1
Authorization: Bearer {{token}}

### Actualizar usuario (admin)
PUT {{baseUrl}}/users/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "David",
  "surname": "Gonzalez",
  "email": "davidgonzalez@gmail.com",
  "avatar_url":
}

### Eliminar usuario (admin)
DELETE {{baseUrl}}/users/1
Authorization: Bearer {{token}}